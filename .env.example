# =============================================================
# Turfzo Environment Variables Template
# =============================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# Then fill in real values. NEVER commit `.env.local`.
#
# Vercel: set these in Project Settings → Environment Variables.
# Convex: set server-only secrets with `npx convex env set KEY VALUE`.
# =============================================================


# -------------------------------------------------------------
# Firebase (Web) — get from Firebase Console → Project Settings
# -------------------------------------------------------------
# Public — safe to ship to browser. Vercel: set for all 3 envs.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=


# -------------------------------------------------------------
# Convex — get from Convex Dashboard → Settings
# -------------------------------------------------------------
# Public: the deployment URL your frontend talks to.
#   Dev:    https://<dev-deployment>.convex.cloud
#   Prod:   https://<prod-deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_DEPLOYMENT_URL=

# Server: CI-only deploy key (used by GitHub Actions to push schema).
# Get from: Convex Dashboard → Settings → Deploy Keys
CONVEX_DEPLOY_KEY=


# -------------------------------------------------------------
# Cashfree — get from Cashfree Dashboard → Developers → API Keys
# -------------------------------------------------------------
# Public: APP ID.
# Use TEST keys in Preview, LIVE keys in Production.
NEXT_PUBLIC_CASHFREE_APP_ID=

# Server-only: never expose to browser. Use TEST in Preview, LIVE in Production.
CASHFREE_SECRET_KEY=

# Server-only: webhook signing secret.
CASHFREE_WEBHOOK_SECRET=


# -------------------------------------------------------------
# Cloudflare Turnstile — get from Cloudflare Dashboard → Turnstile
# -------------------------------------------------------------
# Public: site key, safe in browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: secret key. Never expose. If unset, bot protection
# is skipped in dev (with a console warning).
TURNSTILE_SECRET_KEY=


# -------------------------------------------------------------
# Monitoring (optional, recommended for production)
# -------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# -------------------------------------------------------------
# Email (optional, for transactional emails)
# -------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
